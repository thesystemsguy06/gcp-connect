#!/bin/bash
# VectorPlane One-Click Deployment Auto-Execution
# This executes automatically when Cloud Shell initializes

# Clear terminal for focused experience
clear

echo ""
echo "████████████████████████████████████████████████████████████████"
echo "🚀 VECTORPLANE GCP ONBOARDING - AUTO-DEPLOYMENT READY"
echo "████████████████████████████████████████████████████████████████"
echo ""

# Verify environment first
if [ -z "$VP_TOKEN" ] || [ -z "$VP_API_BASE" ]; then
    echo "❌ Session configuration missing. Please restart from VectorPlane."
    echo "   Required: VP_TOKEN and VP_API_BASE environment variables"
    echo ""
    exit 1
fi

echo "✅ Secure session verified"
echo "✅ Environment: $VP_API_BASE"
echo ""

# Offer true one-click deployment
echo "🎯 ONE-CLICK DEPLOYMENT OPTIONS:"
echo ""
echo "   [1] FULL AUTO-DEPLOY: Complete integration in one command"
echo "   [2] GUIDED STEPS: Use tutorial sidebar for step-by-step"
echo "   [3] MANUAL: Run commands yourself"
echo ""

read -p "Choose option [1-3] or press Enter for FULL AUTO-DEPLOY: " choice

case ${choice:-1} in
    1)
        echo ""
        echo "🚀 Starting full auto-deployment..."
        echo "════════════════════════════════════════════════════════════════"

        echo "Step 1/3: Syncing VectorPlane configuration..."
        if ./setup_env.sh; then
            echo "✅ Configuration synced successfully"
        else
            echo "❌ Configuration sync failed"
            exit 1
        fi

        echo ""
        echo "Step 2/3: Initializing Terraform..."
        if terraform init; then
            echo "✅ Terraform initialized successfully"
        else
            echo "❌ Terraform initialization failed"
            exit 1
        fi

        echo ""
        echo "Step 3/3: Deploying VectorPlane integration..."
        if terraform apply -auto-approve; then
            echo ""
            echo "🎉 SUCCESS! VectorPlane GCP integration deployed!"
            echo "✅ Your GCP project is now connected securely"
            echo "✅ Check your VectorPlane dashboard for findings"
        else
            echo "❌ Deployment failed"
            exit 1
        fi
        ;;
    2)
        echo ""
        echo "📖 Click START in the tutorial sidebar (right panel) for guided steps"
        echo ""
        ;;
    3)
        echo ""
        echo "⚡ Manual mode: Run './setup_env.sh' when ready"
        echo ""
        ;;
    *)
        echo ""
        echo "📖 Invalid option. Click START in tutorial sidebar or run './setup_env.sh'"
        echo ""
        ;;
esac
