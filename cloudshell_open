#!/bin/bash
# VectorPlane GCP Onboarding - Cloud Shell Auto-Execution Hook
# This script runs automatically when Cloud Shell opens

# Display welcome message
if [ -f "README-cloudshell.txt" ]; then
    cat README-cloudshell.txt
    echo ""
fi

# Provide immediate guidance
echo "🎯 Ready to start? Follow these steps:"
echo "   1. Click START in the tutorial pane (right sidebar)"
echo "   2. Click 'Sync VectorPlane Configuration' button"
echo "   3. Follow the guided steps to completion"
echo ""

# Verify environment is ready
if [ -n "$VP_TOKEN" ]; then
    echo "✅ VP_TOKEN configured - environment ready"
else
    echo "❌ VP_TOKEN missing - please restart from VectorPlane"
fi

echo ""
echo "📖 Tutorial guide: Click START in the right panel"
echo "⚡ Quick start: Run ./setup_env.sh"
echo ""
